  "state": {
    "bundling": {
      "captions": [
        "Reading every descriptor twice, just in case.",
        "Sorting dependencies before they sort us.",
        "Asking the export layer what it is allowed to say.",
        "Waiting for a plugin that promised to come.",
        "Collecting class loaders nobody misses."
      ]
    }
  },
  "urls": {
    "github": "https://github.com/whereareiam/chassis"
  },
  "links": [
    {
      "type": "icon",
      "label": "GitHub",
      "icon": "github",
      "url": "https://github.com/whereareiam/chassis",
      "external": true
    },
    {
      "type": "icon",
      "label": "Discord",
      "icon": "discord",
      "url": "https://discord.arcadeya.com",
      "external": true
    }
  ],
  "i18n": {
